{
  "name": "nen-archive-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Hunter x Hunter world simulation for the Nen Archive. Every character lives, trains, loves, feuds and fights on their own.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim": "tsx scripts/simulate.ts",
    "balance": "tsx scripts/balance.ts",
    "import:archive": "node scripts/import-archive.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "~19.2.0",
    "@vitejs/plugin-react": "5.2.0",
    "tsx": "^4.19.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "3.2.7"
  }
}
